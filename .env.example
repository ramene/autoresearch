# Autoresearch — API Keys
# Copy this file to .env and fill in your keys
# cp .env.example .env

# Gemini API Key (required for evaluation)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic API Key (optional — only needed if using API models as mutator)
# Get one at: https://console.anthropic.com/settings/keys
# Not needed if using claude CLI models (sonnet/opus/haiku) via Max plan
ANTHROPIC_API_KEY=
